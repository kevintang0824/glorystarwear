{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glorystarwear-lead-receiver",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "lead-webhook.glorystarwears.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glorystarwear-leads",
      "database_id": "b092b565-2303-4c2c-89c3-7477031d5acb",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
